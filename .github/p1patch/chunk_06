fn period_repository_rejects_duplicate_tax_year_month() {
    let conn = create_in_memory_connection().unwrap();
    let p1 = period("2026-05", 2026, 5, 2026, 6);
    let p2 = period("2026-06", 2026, 6, 2026, 6);
