from pathlib import Path

# Compatibility prelude: current main's PersonelKesintileri does not derive Default,
# while the staged transformation's structural marker expects it. Adding Default is
# backwards-compatible because every field is Option<T>.
p = Path('src-tauri/src/domain/models.rs')
t = p.read_text(encoding='utf-8')
old = '''#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct PersonelKesintileri {
'''
new = '''#[derive(Debug, Clone, Serialize, Deserialize, Default)]
#[serde(rename_all = "camelCase")]
pub struct PersonelKesintileri {
'''
if old in t:
    t = t.replace(old, new, 1)
elif new not in t:
    raise RuntimeError('PersonelKesintileri compatibility marker not found')
p.write_text(t, encoding='utf-8')

