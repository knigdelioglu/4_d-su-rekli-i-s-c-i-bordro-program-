from pathlib import Path

# Compatibility prelude: current main's PersonelKesintileri does not derive Default,
# while the staged transformation's structural marker expects it. Adding Default is
# backwards-compatible because every field is Option<T>.
p = Path('src-tauri/src/domain/models.rs')
t = p.read_text(encoding='utf-8')
old = '''#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct PersonelKesintileri {
'''
new = '''#[derive(Debug, Clone, Serialize, Deserialize, Default)]
#[serde(rename_all = "camelCase")]
pub struct PersonelKesintileri {
'''
if old in t:
    t = t.replace(old, new, 1)
elif new not in t:
    raise RuntimeError('PersonelKesintileri compatibility marker not found')
p.write_text(t, encoding='utf-8')

# Compatibility prelude for the older money conversion implementation currently on
# main. Normalize it to the structural form consumed by chunk_01; chunk_01 then
# replaces this with the final fallible Result<i64> implementation.
p = Path('src-tauri/src/repositories/mod.rs')
t = p.read_text(encoding='utf-8')
if 'use crate::domain::{DomainError, Result};' not in t:
    t = 'use crate::domain::{DomainError, Result};\n' + t
old = '''pub fn dec_to_kurus(d: Option<Decimal>) -> i64 {
    match d {
        Some(dec) => (dec * Decimal::from(100)).round().to_i64().unwrap_or(0),
        None => 0,
    }
}

pub fn opt_dec_to_kurus(d: Option<Decimal>) -> Option<i64> {
    d.map(|dec| (dec * Decimal::from(100)).round().to_i64().unwrap_or(0))
}
'''
normalized = '''pub fn dec_to_kurus(d: Option<Decimal>) -> i64 {
    d.unwrap_or_default()
        .checked_mul(Decimal::from(100))
        .unwrap_or_default()
        .round()
        .to_i64()
        .unwrap_or(0)
}

pub fn opt_dec_to_kurus(d: Option<Decimal>) -> Option<i64> {
    d.map(|value| {
        value
            .checked_mul(Decimal::from(100))
            .unwrap_or_default()
            .round()
            .to_i64()
            .unwrap_or(0)
    })
}
'''
if old in t:
    t = t.replace(old, normalized, 1)
elif normalized not in t and 'pub fn dec_to_kurus(d: Option<Decimal>) -> Result<i64>' not in t:
    raise RuntimeError('repositories/mod.rs compatibility conversion functions not found')
p.write_text(t, encoding='utf-8')

