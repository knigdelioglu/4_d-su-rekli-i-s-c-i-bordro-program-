{
  "name": "4d-bordro-programi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "if command -v wasm-pack >/dev/null 2>&1; then bun run wasm:ensure; fi",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "bun run verify:wasm-freshness && vite build",
    "web:verify": "bun scripts/verify-web-build.mjs",
    "verify:wasm-package": "bun scripts/verify-wasm-package.mjs",
    "verify:wasm-freshness": "bun scripts/verify-wasm-freshness.mjs",
    "wasm:build": "node scripts/build-wasm.mjs",
    "wasm:ensure": "node scripts/ensure-wasm.mjs",
    "wasm:test": "wasm-pack test --node crates/payroll-wasm",
    "web:build": "bun run wasm:ensure && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test": "bun test",
    "test:coverage": "bun test --parallel=1 --max-concurrency=1 --path-ignore-patterns=**/{api.browser,CompensationPolicyPage,PuantajGrid}.test.{ts,tsx} --coverage --coverage-reporter=lcov --coverage-dir=coverage/bun",
    "check:ts-coverage": "node scripts/check-ts-coverage.mjs coverage/bun/lcov.info docs/typescript-coverage-baseline.json",
    "test:browser-ui": "bun test --parallel=1 --max-concurrency=1 --timeout=30000 src/components/Settings/CompensationPolicyPage.test.tsx && bun test --parallel=1 --max-concurrency=1 --timeout=30000 src/components/PuantajGrid.test.tsx",
    "test:browser-integration": "bun test --parallel=1 --max-concurrency=1 --timeout=30000 src/services/compensationPolicy/api.browser.test.ts",
    "test:ci": "bun run test:coverage && bun run test:browser-ui && bun run test:browser-integration && bun run check:ts-coverage",
    "test:rust": "if command -v cargo-nextest >/dev/null 2>&1; then cargo nextest run --manifest-path src-tauri/Cargo.toml; else cargo test --manifest-path src-tauri/Cargo.toml; fi",
    "test:rust:nextest": "cargo nextest run --manifest-path src-tauri/Cargo.toml",
    "test:rust:coverage": "cargo llvm-cov --package payroll-core --package bordro-programi --all-features --json --summary-only --output-path target/payroll-coverage.json && node scripts/check-rust-coverage.mjs target/payroll-coverage.json docs/payroll-coverage-baseline.json",
    "test:rust:mutation": "cargo mutants --manifest-path crates/payroll-core/Cargo.toml --package payroll-core --no-shuffle",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "lint": "tsc --noEmit && bun run verify:production-graph",
    "verify:production-graph": "bun scripts/verify-production-graph.mjs",
    "verify:payroll-contract": "node scripts/generate-payroll-contract.mjs",
    "verify:privacy": "bun scripts/verify-privacy-boundary.mjs",
    "test:netlify-smoke": "bun scripts/test-netlify-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:typecheck": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e:native": "node scripts/test-tauri-webdriver.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "xlsx-js-style": "1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.14.0",
    "fflate": "0.3.11",
    "netlify-cli": "27.4.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "0.18.5"
  }
}
